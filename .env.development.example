# Local development uses a dedicated Supabase development project.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Keep this on "log" until you explicitly need an end-to-end email test.
RESEND_API_KEY=
RESEND_FROM_EMAIL=PhasePrep Navigator <onboarding@resend.dev>
RESEND_WEBHOOK_SECRET=
EMAIL_DELIVERY_MODE=log
EMAIL_TEST_RECIPIENT=
