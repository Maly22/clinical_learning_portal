# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.nyc_output/
/test-results/
/playwright-report/

# next.js
/.next/
/out/
/.turbo/
/.swc/

# production
/build
/dist/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.key
*.crt
*.p12
/AppData/
/work/
/.agents/
/.codex/
/.idea/
/.vscode/*.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.eslintcache
.stylelintcache

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.development.example
!.env.production.example
!.env.*.example

# vercel
/.vercel/

# Supabase local state and generated secrets
/supabase/.branches
/supabase/.temp
/.supabase/
/supabase/.env
/supabase/.env.*
/supabase/*.dump
/supabase/*.backup

# typescript
*.tsbuildinfo
next-env.d.ts
.vercel
